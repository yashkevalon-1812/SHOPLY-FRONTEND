# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Set these in Vercel: Settings -> Environment Variables (all environments).

# Base URL the axios client calls. Must be your deployed backend, including /api.
# Local dev uses "/api", which Vite proxies to http://localhost:5000 (see vite.config.js).
# In production there is no proxy, so this must be an absolute URL, e.g.
#   https://shoply-api.onrender.com/api
VITE_API_BASE_URL=https://shoply-api.onrender.com/api

VITE_APP_NAME=Shoply
VITE_APP_TAGLINE=Fashion that feels like you.
VITE_APP_DESCRIPTION=Shop thousands of products from independent sellers.
VITE_CONTACT_EMAIL=support@shoply.com
VITE_CONTACT_PHONE=+91 12345 67890

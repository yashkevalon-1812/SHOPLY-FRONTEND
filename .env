# =========================================================================
# Velora / Shoply Frontend - Environment Configuration
# =========================================================================

# Base URL for API requests. 
# In local development, leaving this as "/api" uses Vite's proxy (configured in vite.config.js -> http://localhost:5000).
# For production or direct backend access, set to your full API endpoint (e.g. http://localhost:5000/api or https://api.velora.com/api)
VITE_API_BASE_URL=/api

# Application Branding & Metadata
VITE_APP_NAME="Shoply"
VITE_APP_TAGLINE="Everything Store"
VITE_APP_DESCRIPTION="Curated luxury goods, smartphones, timepieces, bespoke fashion & gaming gear."

# Optional Support & Contact Information
VITE_CONTACT_EMAIL="support@shoply.com"
VITE_CONTACT_PHONE="+1 (555) 890-2341"
